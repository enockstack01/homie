MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appname>
MONGODB_DB_NAME=arcgis_ai_proxy

CLERK_SECRET_KEY=sk_test_or_live_...
# Origin(s) of whatever frontend actually creates the Clerk session - the admin
# dashboard's URL, NOT this backend's own URL. Comma-separated for multiple (e.g. add
# your production dashboard domain once deployed). Only affects browser session-token
# auth; the desktop Add-in's Clerk Machine secret key doesn't go through this check.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

ANTHROPIC_API_KEY=sk-ant-...

ENVIRONMENT=development
